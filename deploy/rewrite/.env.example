APP_VERSION=0.1.0
APP_IMAGE_MODE=build
COMPOSE_PROJECT_NAME=spina-bifida
BACKEND_CPU_IMAGE=spina-bifida-backend:0.1.0-cpu
BACKEND_GPU_IMAGE=spina-bifida-backend:0.1.0-gpu
FRONTEND_IMAGE=spina-bifida-frontend:0.1.0
TRAEFIK_IMAGE=traefik:v3.3
APP_CONFIG_PATH=./config/app.yaml
APP_ENV_FILE=.env
MODELS_DIR=./models
TRAEFIK_DYNAMIC_CONFIG=./traefik/http.yaml
TRAEFIK_ACME_EMAIL=
APP_SESSION_SECRET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Optional source-build mirrors (defaults remain the original upstreams).
# BUILD_DOCKERFILE_FRONTEND=docker/dockerfile:1.7
# BUILD_PYTHON_IMAGE=python:3.12-slim-bookworm
# BUILD_NODE_IMAGE=node:22-bookworm-slim
# BUILD_NGINX_IMAGE=nginxinc/nginx-unprivileged:1.27-alpine
# BUILD_DEBIAN_MIRROR=http://deb.debian.org/debian
# BUILD_DEBIAN_SECURITY_MIRROR=http://deb.debian.org/debian-security
# BUILD_NPM_REGISTRY=https://registry.npmjs.org
# With verified CPU wheels in apps/backend/requirements/wheels/, uncomment BOTH:
# BUILD_TORCH_CPU_INDEX_URL=
# BUILD_PIP_FIND_LINKS=/build/requirements/wheels

# Optional externally issued certificate (e.g. manual DNS-01).
# Place fullchain.pem and privkey.pem in this root-only directory before install.
# TRAEFIK_TLS_MODE=external
# TRAEFIK_CERTS_DIR=/etc/spina-bifida/tls

# Optional root-only file containing POSTBOX_ACCESS_KEY and POSTBOX_SECRET_KEY.
# Its secrets are never stored in YAML or source control.
POSTBOX_ENV_FILE=./.postbox.env
