ACCESS_KEY=
SECRET_KEY=
BUCKET=

# Logging Configuration
USER_LOGS_BUCKET=
LOCAL_LOGS_DIR=./logs
MAX_LOCAL_LOGS_SIZE_MB=500
CLEANUP_INTERVAL_HOURS=24

# Yandex Cloud Logging Configuration
YC_FOLDER_ID=your-folder-id
#YC_LOG_GROUP_ID=your-log-group-id
YC_SERVICE_ACCOUNT_KEY_FILE=service-account-key.json

# YDB Configuration
YDB_ENDPOINT=grpcs://ydb.serverless.yandexcloud.net:2135
YDB_DATABASE=/ru-central1/your-database-path
YDB_SERVICE_ACCOUNT_KEY_FILE=service-account-key.json

# Admin Configuration
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=StrongPassword123
ADMIN_ORGANIZATION=Your Organization
